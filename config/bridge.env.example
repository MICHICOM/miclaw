# /etc/claw-hub/bridge.env — claw-bridge の設定（秘密は置かない。トークンは LoadCredential で渡す）

# rclone で Drive から同期した受信箱（StateDirectory 配下）
BRIDGE_INBOX_DIR=/var/lib/claw-bridge/inbox
BRIDGE_DB=/var/lib/claw-bridge/bridge.sqlite

# 取り込み元（クラウド側タスクが書き出す Drive フォルダ）。rclone のリモート名:パス
BRIDGE_RCLONE_SRC=gdrive:claw-inbox

# 受け付ける source 名（エンベロープの "source" / ファイル名の先頭）
BRIDGE_ALLOWED_SOURCES=chatgpt-work,claude-cowork,gemini-spark

# 報告先（Discord チャンネル）
BRIDGE_DELIVER_CHANNEL=discord
BRIDGE_DELIVER_TO=channel:__DISCORD_CHANNEL_ID__

OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks/agent
BRIDGE_MAX_BYTES=262144
BRIDGE_MAX_AGE_DAYS=7
BRIDGE_MAX_ATTEMPTS=5
BRIDGE_BACKOFF_BASE_SEC=60
BRIDGE_READER_TIMEOUT_SEC=300
# 成果物の根拠URLを HTTP ステータスだけ確認する（F-07）。0 で無効
BRIDGE_VERIFY_URLS=1
